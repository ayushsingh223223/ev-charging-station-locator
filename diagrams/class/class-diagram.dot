digraph G{rankdir=TB;splines=true;nodesep=0.7;ranksep=1.1;newrank=true;node[shape=plain,fontname="DejaVu Sans",fontsize=11];edge[fontname="DejaVu Sans",fontsize=10];
User[label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#0D47A1"><TR><TD BGCOLOR="#BBDEFB"><FONT POINT-SIZE="9">«abstract»</FONT></TD></TR><TR><TD BGCOLOR="#BBDEFB"><B><I>User</I></B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5FAFF">+ userId : int<BR ALIGN="LEFT"/>+ name : String<BR ALIGN="LEFT"/>+ email : String<BR ALIGN="LEFT"/>+ passwordHash : String<BR ALIGN="LEFT"/>+ phone : String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5FAFF">+ register()<BR ALIGN="LEFT"/>+ login()<BR ALIGN="LEFT"/>+ logout()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
EVUser[label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#0D47A1"><TR><TD BGCOLOR="#BBDEFB"><B>EVUser</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5FAFF">+ vehicleModel : String<BR ALIGN="LEFT"/>+ preferredConnector : ConnectorType<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5FAFF">+ searchStation()<BR ALIGN="LEFT"/>+ findNearest()<BR ALIGN="LEFT"/>+ viewStationDetails()<BR ALIGN="LEFT"/>+ getNavigation()<BR ALIGN="LEFT"/>+ bookSlot()<BR ALIGN="LEFT"/>+ rateStation()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Admin[label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#0D47A1"><TR><TD BGCOLOR="#BBDEFB"><B>Admin</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5FAFF">+ adminLevel : String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5FAFF">+ addStation()<BR ALIGN="LEFT"/>+ updateStation()<BR ALIGN="LEFT"/>+ manageUsers()<BR ALIGN="LEFT"/>+ manageBookings()<BR ALIGN="LEFT"/>+ monitorStatus()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
ChargingStation[label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#0D47A1"><TR><TD BGCOLOR="#BBDEFB"><B>ChargingStation</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5FAFF">+ stationId : int<BR ALIGN="LEFT"/>+ name : String<BR ALIGN="LEFT"/>+ address : String<BR ALIGN="LEFT"/>+ operatingHours : String<BR ALIGN="LEFT"/>+ status : StationStatus<BR ALIGN="LEFT"/>+ avgRating : float<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5FAFF">+ getDetails()<BR ALIGN="LEFT"/>+ updateStatus()<BR ALIGN="LEFT"/>+ calculateDistance(loc)<BR ALIGN="LEFT"/>+ checkAvailability()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Booking[label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#0D47A1"><TR><TD BGCOLOR="#BBDEFB"><B>Booking</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5FAFF">+ bookingId : int<BR ALIGN="LEFT"/>+ startTime : DateTime<BR ALIGN="LEFT"/>+ endTime : DateTime<BR ALIGN="LEFT"/>+ status : BookingStatus<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5FAFF">+ createBooking()<BR ALIGN="LEFT"/>+ confirm()<BR ALIGN="LEFT"/>+ cancel()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Payment[label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#0D47A1"><TR><TD BGCOLOR="#BBDEFB"><B>Payment</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5FAFF">+ paymentId : int<BR ALIGN="LEFT"/>+ amount : float<BR ALIGN="LEFT"/>+ method : String<BR ALIGN="LEFT"/>+ status : PaymentStatus<BR ALIGN="LEFT"/>+ transactionRef : String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5FAFF">+ makePayment()<BR ALIGN="LEFT"/>+ refund()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Review[label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#0D47A1"><TR><TD BGCOLOR="#BBDEFB"><B>Review</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5FAFF">+ reviewId : int<BR ALIGN="LEFT"/>+ rating : int<BR ALIGN="LEFT"/>+ comment : String<BR ALIGN="LEFT"/>+ reviewDate : Date<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5FAFF">+ submit()<BR ALIGN="LEFT"/>+ edit()<BR ALIGN="LEFT"/>+ delete()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
SearchService[label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#0D47A1"><TR><TD BGCOLOR="#BBDEFB"><FONT POINT-SIZE="9">«control»</FONT></TD></TR><TR><TD BGCOLOR="#BBDEFB"><B>SearchService</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5FAFF"> </TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5FAFF">+ searchStations(loc, radius, filter)<BR ALIGN="LEFT"/>+ findNearest(loc)<BR ALIGN="LEFT"/>+ applyFilter(filter)<BR ALIGN="LEFT"/>+ sortByDistance()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
MapService[label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#0D47A1"><TR><TD BGCOLOR="#BBDEFB"><FONT POINT-SIZE="9">«external»</FONT></TD></TR><TR><TD BGCOLOR="#BBDEFB"><B>MapService</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5FAFF">+ providerName : String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5FAFF">+ getCurrentLocation()<BR ALIGN="LEFT"/>+ getDirections(from, to)<BR ALIGN="LEFT"/>+ renderMap()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
PaymentGateway[label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#0D47A1"><TR><TD BGCOLOR="#BBDEFB"><FONT POINT-SIZE="9">«external»</FONT></TD></TR><TR><TD BGCOLOR="#BBDEFB"><B>PaymentGateway</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5FAFF">+ gatewayName : String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F5FAFF">+ authorize(amount)<BR ALIGN="LEFT"/>+ capture()<BR ALIGN="LEFT"/>+ refund(txnRef)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Location[label=<<TABLE BORDER="2" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#E65100"><TR><TD BGCOLOR="#FFE0B2"><B>Location</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF8F0">+ latitude : double<BR ALIGN="LEFT"/>+ longitude : double<BR ALIGN="LEFT"/>+ city : String<BR ALIGN="LEFT"/>+ pincode : String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF8F0">+ distanceTo(loc) : double<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
ChargingSlot[label=<<TABLE BORDER="2" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#E65100"><TR><TD BGCOLOR="#FFE0B2"><B>ChargingSlot</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF8F0">+ slotNo : int  {partial key}<BR ALIGN="LEFT"/>+ status : SlotStatus<BR ALIGN="LEFT"/>+ powerKW : float<BR ALIGN="LEFT"/>+ chargingSpeed : String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF8F0">+ isAvailable()<BR ALIGN="LEFT"/>+ reserve()<BR ALIGN="LEFT"/>+ release()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
Connector[label=<<TABLE BORDER="2" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#E65100"><TR><TD BGCOLOR="#FFE0B2"><B>Connector</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF8F0">+ connectorNo : int  {partial key}<BR ALIGN="LEFT"/>+ connectorType : ConnectorType<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF8F0">+ isCompatible(vehicle)<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
AvailabilityRecord[label=<<TABLE BORDER="2" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#E65100"><TR><TD BGCOLOR="#FFE0B2"><B>AvailabilityRecord</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF8F0">+ recordTime : DateTime  {partial key}<BR ALIGN="LEFT"/>+ availableChargers : int<BR ALIGN="LEFT"/>+ status : String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF8F0">+ getLatest()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
SearchHistory[label=<<TABLE BORDER="2" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#E65100"><TR><TD BGCOLOR="#FFE0B2"><B>SearchHistory</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF8F0">+ searchNo : int  {partial key}<BR ALIGN="LEFT"/>+ searchTime : DateTime<BR ALIGN="LEFT"/>+ radiusKm : float<BR ALIGN="LEFT"/>+ filters : String<BR ALIGN="LEFT"/>+ resultCount : int<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFF8F0">+ save()<BR ALIGN="LEFT"/>+ clear()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
